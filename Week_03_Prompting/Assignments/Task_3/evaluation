import csv
import json
import re
import sys
import sqlite3
from collections import Counter, defaultdict, deque
from pathlib import Path


DATA_DIR = Path(__file__).resolve().parent.parent / "Task_2" / "data"
LABELS_PATH = DATA_DIR / "restaurants_dataset.csv"
PREDICTION_FILES = {
    "RTF": "restaurants_dataset_RTFpredictions.csv",
    "ICIO": "restaurants_dataset_ICIOpredictions.csv",
    "Few-Shot": "restaurants_dataset_FewShotpredictions.csv",
}

SCHEMA_PATH = DATA_DIR / "restaurants-schema.csv"
DATABASE_PATH = DATA_DIR / "restaurants-db.txt"


def sqlite_type(schema_type):
    normalized_type = schema_type.strip().lower()
    if normalized_type.startswith("int"):
        return "INTEGER"
    if normalized_type.startswith("decimal") or normalized_type.startswith("float"):
        return "REAL"
    return "TEXT"


def load_database():
    tables = {}
    with SCHEMA_PATH.open(encoding="utf-8", newline="") as schema_file:
        for table, field, primary_key, _foreign_key, column_type in csv.reader(
            schema_file, skipinitialspace=True
        ):
            table = table.strip()
            field = field.strip()
            if table == "-":
                continue
            tables.setdefault(table, []).append(
                (field, sqlite_type(column_type), primary_key.strip().lower() == "y")
            )

    connection = sqlite3.connect(":memory:")
    for table, columns in tables.items():
        definitions = []
        for field, column_type, primary_key in columns:
            definition = f'"{field}" {column_type}'
            if primary_key:
                definition += " PRIMARY KEY"
            definitions.append(definition)
        connection.execute(f'CREATE TABLE "{table}" ({", ".join(definitions)})')

    with DATABASE_PATH.open(encoding="utf-8") as database_file:
        for line_number, line in enumerate(database_file, start=1):
            match = re.fullmatch(r"([A-Z_]+)\((.*)\)", line.rstrip("\r\n"))
            if match is None:
                raise ValueError(f"Invalid database record on line {line_number}")

            table, values_text = match.groups()
            if table not in tables:
                raise ValueError(f"Unknown table {table!r} on line {line_number}")

            values = next(csv.reader([values_text], skipinitialspace=True))
            columns = tables[table]
            if len(values) != len(columns):
                raise ValueError(
                    f"Expected {len(columns)} values for {table} on line "
                    f"{line_number}, got {len(values)}"
                )

            converted_values = []
            for value, (_field, column_type, _primary_key) in zip(values, columns):
                if column_type == "INTEGER":
                    converted_values.append(int(value))
                elif column_type == "REAL":
                    converted_values.append(float(value))
                else:
                    converted_values.append(value)

            placeholders = ", ".join("?" for _ in columns)
            connection.execute(
                f'INSERT INTO "{table}" VALUES ({placeholders})', converted_values
            )

    return connection


def row_multiset(rows):
    return Counter(tuple(row) for row in rows)


def find_file(name):
    path = DATA_DIR / name
    if not path.exists():
        raise FileNotFoundError(f"Súbor {name} som nenašiel v {DATA_DIR}")
    return path


def load_labels():
    labels = []
    with LABELS_PATH.open(encoding="utf-8", newline="") as source:
        for line_number, row in enumerate(csv.DictReader(source), start=2):
            try:
                result = json.loads(row["result"])
            except json.JSONDecodeError as error:
                raise ValueError(
                    f"Invalid JSON label result on line {line_number} of {LABELS_PATH}"
                ) from error
            labels.append((row["question"], result))
    return labels


def evaluate(predictions_path, labels, connection):
    labels_by_question = defaultdict(deque)
    for question, result in labels:
        labels_by_question[question].append(result)

    total = correct = 0
    total_nonempty = correct_nonempty = 0  
    with predictions_path.open(encoding="utf-8-sig", newline="") as source:
        for line_number, row in enumerate(csv.DictReader(source), start=2):
            question = row["question"]
            if not labels_by_question[question]:
                raise ValueError(
                    f"No matching label question for prediction on line "
                    f"{line_number} of {predictions_path.name}: {question!r}"
                )
            expected_rows = labels_by_question[question].popleft()
            try:
                predicted_rows = connection.execute(row["predicted_sql"]).fetchall()
            except sqlite3.Error as error:
                raise RuntimeError(
                    f"Could not execute predicted SQL on line {line_number} "
                    f"of {predictions_path.name}"
                ) from error

            is_correct = row_multiset(predicted_rows) == row_multiset(expected_rows)
            total += 1
            correct += is_correct
            if expected_rows: 
                total_nonempty += 1
                correct_nonempty += is_correct

    unmatched = sum(len(r) for r in labels_by_question.values())
    if unmatched:
        raise ValueError(f"{predictions_path.name}: {unmatched} label records had no corresponding prediction")
    return correct, total, correct_nonempty, total_nonempty


def main():
    csv.field_size_limit(1_000_000_000)
    labels = load_labels()
    connection = load_database()
    results = []
    try:
        for prompt, filename in PREDICTION_FILES.items():
            results.append((prompt, *evaluate(find_file(filename), labels, connection)))
    finally:
        connection.close()

    print(f"{'Framework':<10} {'Accuracy':>20}   {'Non-empty accuracy':>22}")
    print("-" * 58)
    for prompt, c, t, ci, ti in results:
        print(f"{prompt:<10} {c / t:>8.2%} ({c:>3}/{t})   {ci / ti:>10.2%} ({ci:>3}/{ti})")


if __name__ == "__main__":
    main()